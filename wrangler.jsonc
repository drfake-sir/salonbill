// SalonBill — PRODUCTION Worker config (prepare only — nothing here deploys).
//
// Kept separate from wrangler.local.json, which `npm run dev:worker` uses and
// which this file does not modify or replace.
//
// ── BEFORE DEPLOYING ────────────────────────────────────────────────────────
// Replace the database_id placeholder below with a real id:
//     npx wrangler d1 create salonbill
// then paste the id that command prints into "database_id".
//
// ── DEPLOY COMMANDS (run them yourself) ─────────────────────────────────────
//     npm run build
//     npx wrangler deploy --config wrangler.jsonc
//
// ── SYNC TABLES ─────────────────────────────────────────────────────────────
// sb_rows / sb_counters / sb_auth are created AUTOMATICALLY ON FIRST USE:
// every sync/backup call runs ensureSchema(), which issues idempotent
// CREATE TABLE IF NOT EXISTS statements, so a brand-new database needs no
// migration step. If you prefer to create them up front, run this ONE command:
//
//   npx wrangler d1 execute salonbill --remote --config wrangler.jsonc --command "CREATE TABLE IF NOT EXISTS sb_rows (table_name TEXT NOT NULL, row_id INTEGER NOT NULL, data TEXT, server_at INTEGER NOT NULL, PRIMARY KEY (table_name, row_id)); CREATE INDEX IF NOT EXISTS sb_rows_by_time ON sb_rows (server_at); CREATE TABLE IF NOT EXISTS sb_counters (key TEXT PRIMARY KEY, value INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS sb_auth (key TEXT PRIMARY KEY, value TEXT NOT NULL)"
{
  // Worker name shown in the Cloudflare dashboard and in `wrangler` output.
  "name": "salonbill",

  // Build output of `npm run build` (Vite + TanStack Start → Nitro worker).
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dependencies are already bundled by the build; let wrangler upload as-is.
  "no_bundle": true,

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },

  // Optional — the automatic daily cloud backup (D1 → R2), reported in
  // Settings → Cloud backup. Needs:
  //     npx wrangler r2 bucket create salonbill-backups
  // To enable it, paste this AFTER d1_databases (and re-add the comma after
  // d1_databases' closing bracket):
  //   "r2_buckets": [
  //     { "binding": "BACKUPS", "bucket_name": "salonbill-backups" }
  //   ],
  // Without this binding the app still runs and simply shows "Cloud backup
  // storage is not enabled on this app"; local JSON backup, restore and CSV
  // export keep working.

  "d1_databases": [
    {
      // Read by the sync layer as env.DB (see src/server/d1Store.ts).
      "binding": "DB",
      "database_name": "salonbill",
      // ⚠️ PLACEHOLDER — REPLACE THIS VALUE before deploying.
      // Run `npx wrangler d1 create salonbill` and paste the id it prints.
      // Leaving it as-is will make the deploy fail.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
